# Python caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Raw captures and downloaded datasets must stay local
*.pcap
*.pcapng
data/raw/
data/downloads/

# Generated or machine-specific artifacts
tmp/
output/models/*
!output/models/dns_dga_demo.json
output/real_*
output/*.db
# Continuous-ingest journals contain local traffic; never commit SQLite sidecars.
output/*.db.lock
output/*.db-journal
output/*.db-wal
output/*.db-shm
output/*.db.lock-journal
# Local security material; never version real credentials or signing keys.
output/security/
output/backups/
output/restore/
output/operations/
.env
.env.local
*.key
bootstrap-tokens.json
web/node_modules/
web/dist/
*.tsbuildinfo

# Packaging output
build/
dist/
*.egg-info/
